# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# --- Virtual environments ---
my_env/
venv/
.venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Generated output (rules are the source, reports are the product) ---
reports/*
!reports/.gitkeep

# The split is deterministic (seed=42), so the CSVs regenerate byte for
# byte from the samples/ files -- the builder is the source, not its output.
dataset/processed/*
!dataset/processed/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
